{
  "name": "arona",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djobbo/arona.git"
  },
  "type": "module",
  "scripts": {
    "ci:install": "pnpm install --frozen-lockfile",
    "build": "vp run -r build",
    "dev": "vp run -r --parallel dev",
    "test": "vp run -r test",
    "check": "vp check",
    "check:types": "vp run -r check:types",
    "check:lint": "vp lint",
    "lint": "vp lint --fix",
    "fmt": "vp fmt",
    "docs:dev": "vp run --filter docs dev",
    "docs:build": "vp run --filter docs build",
    "publish:dev": "vpx scripts/publish-dev.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.23.0"
}
