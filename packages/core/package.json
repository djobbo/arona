{
  "name": "@arona/core",
  "version": "0.0.0-dev",
  "description": "Effect UI based core for Arona chat bots",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djobbo/arona.git"
  },
  "bin": {
    "arona": "bin/cli.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "require": "./dist/cli.cjs",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check:types": "tsc --noEmit",
    "check:lint": "vp lint"
  },
  "dependencies": {
    "@effect/ui": "catalog:",
    "dotenv": "^16.5.0",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.6",
    "typescript": "^5.8.3"
  }
}
