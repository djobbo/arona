{
  "name": "@arona/discord",
  "version": "0.0.0-dev",
  "description": "Discord integration for Arona",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djobbo/arona.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "require": "./dist/testing.cjs",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "generate": "vpx src/commands/generators/command-builder.ts",
    "test": "vp test",
    "check:types": "tsc --noEmit",
    "check:lint": "vp lint"
  },
  "dependencies": {
    "@arona/core": "workspace:*",
    "@effect/ui": "catalog:",
    "@resvg/resvg-js": "^2.6.2",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "effect": "catalog:",
    "ts-morph": "^26.0.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.6",
    "typescript": "^5.8.3"
  }
}
