{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "declaration": true,
    "paths": {
      "@arona/core": ["./packages/core/src/index.ts"],
      "@arona/core/cli": ["./packages/core/src/cli/index.ts"],
      "@arona/discord": ["./packages/discord/src/index.ts"],
      "@arona/discord/testing": ["./packages/discord/src/testing.ts"],
      "@arona/slack": ["./packages/slack/src/index.ts"],
      "@arona/slack/testing": ["./packages/slack/src/testing/index.ts"]
    }
  }
}
